{
	"$schema": "https://turborepo.com/schema.json",
	"ui": "tui",
	"tasks": {
		"topo": {
			"dependsOn": ["^topo"]
		},
		"build": {
			"dependsOn": ["^build"],
			"outputs": [".cache/tsbuildinfo.json", "dist/**"]
		},
		"dev": {
			"cache": false
		},
		"dev:ios": {
			"cache": false
		},
		"@acme/email#build": {
			"cache": false,
			"outputs": []
		},
		"@acme/auth#build": {
			"cache": false,
			"outputs": []
		},
		"@acme/server#dev": {
			"cache": false,
			"persistent": true
		},
		"@acme/web#dev": {
			"cache": false,
			"persistent": true
		},
		"@acme/expo#dev": {
			"cache": false,
			"persistent": true
		},
		"@acme/expo#dev:ios": {
			"cache": false,
			"persistent": true
		},
		"@acme/email#dev": {
			"cache": false,
			"persistent": true
		},
		"@acme/tanstack-start#dev": {
			"cache": false,
			"persistent": true
		},
		"@acme/programa-gas-ai-lp#dev": {
			"cache": false,
			"persistent": true
		},
		"test": {
			"dependsOn": ["^build"],
			"outputs": [],
			"inputs": ["src/**", "vitest.config.*", "vitest.*.ts"]
		},
		"test:coverage": {
			"dependsOn": ["^build"],
			"outputs": ["coverage/**"],
			"inputs": ["src/**", "vitest.config.*", "vitest.*.ts"]
		},
		"typecheck": {
			"dependsOn": ["^topo", "^build"],
			"outputs": [".cache/tsbuildinfo.json"]
		},
		"clean": {
			"cache": false
		},
		"//#clean": {
			"cache": false
		},
		"push": {
			"cache": false,
			"interactive": true
		},
		"db:studio": {
			"cache": false,
			"persistent": true
		},
		"ui-add": {
			"cache": false,
			"interactive": true
		}
	},
	"globalEnv": [
		"POSTGRES_URL",
		"AUTH_DISCORD_ID",
		"AUTH_DISCORD_SECRET",
		"AUTH_REDIRECT_PROXY_URL",
		"AUTH_SECRET",
		"PORT",
		"PUBLIC_SERVER_URL",
		"VITE_DEV_AUTO_EMAIL",
		"VITE_DEV_AUTO_PASSWORD"
	],
	"globalPassThroughEnv": [
		"NODE_ENV",
		"CI",
		"VERCEL",
		"VERCEL_ENV",
		"VERCEL_URL",
		"npm_lifecycle_event",
		"PUBLIC_SERVER_URL",
		"VITE_DEV_AUTO_EMAIL",
		"VITE_DEV_AUTO_PASSWORD"
	]
}
