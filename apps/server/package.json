{
  "name": "@acme/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "clean": "git clean -xdf node_modules .turbo",
    "db:seed": "pnpm with-env bun run seed/index.ts",
    "dev": "pnpm with-env bun --watch src/index.ts",
    "build": "tsdown",
    "generate:component": "turbo gen react-component",
    "lint": "eslint . --max-warnings 0",
    "with-env": "dotenv -e ../../.env --"
  },
  "dependencies": {
    "@acme/auth": "workspace:*",
    "@acme/email": "workspace:*",
    "@acme/zen-v3": "workspace:*",
    "@ai-sdk/gateway": "^3.0.57",
    "@anthropic-ai/sdk": "^0.78.0",
    "@better-upload/server": "^3.0.14",
    "@bogeychan/elysia-logger": "^0.1.10",
    "@elysiajs/cors": "^1.4.1",
    "@elysiajs/cron": "^1.4.1",
    "@elysiajs/node": "^1.4.5",
    "@elysiajs/openapi": "^1.4.14",
    "@sinclair/typebox": "^0.34.48",
    "@zenstackhq/server": "^3.3.3",
    "ai": "^6.0.103",
    "elysia": "^1.4.26",
    "exceljs": "^4.4.0",
    "kysely": "catalog:",
    "superjson": "2.2.6",
    "unpdf": "^1.4.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@acme/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "dotenv": "^17.3.1",
    "eslint": "catalog:",
    "pino-pretty": "^13.1.3",
    "tsdown": "^0.20.3",
    "tsx": "4.21.0",
    "typescript": "catalog:"
  }
}
