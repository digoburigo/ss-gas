---
---

<section id="funcionalidades" class="py-24" style="background: white;">
  <div class="mx-auto max-w-7xl px-6">
    <!-- Section label -->
    <div class="mb-16">
      <span class="mb-4 inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.1em]" style="color: #1A56DB;">
        <span style="color: rgba(26,86,219,0.4);">──</span>
        Funcionalidades
      </span>
      <h2
        class="mt-3 text-3xl font-extrabold lg:text-4xl"
        style="color: #0D1B2A; font-family: 'Plus Jakarta Sans Variable', sans-serif;"
      >
        Tudo que você precisa para programar gás com confiança.
      </h2>
    </div>

    <!-- Bento grid -->
    <div class="grid gap-5" style="grid-template-columns: 1fr; grid-template-rows: auto;">

      <!-- Row 1: 2fr / 1fr -->
      <div class="grid gap-5 lg:grid-cols-[2fr_1fr]">
        <!-- Contratos com IA — dark, large -->
        <div class="animate-on-scroll flex flex-col rounded-2xl p-10" style="background: #0D1B2A;">
          <div class="mb-4 flex items-center gap-3">
            <div class="flex size-10 items-center justify-center rounded-xl" style="background: rgba(26,86,219,0.25);">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#5BB8D4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                <polyline points="14 2 14 8 20 8"/>
                <line x1="16" y1="13" x2="8" y2="13"/>
                <line x1="16" y1="17" x2="8" y2="17"/>
                <polyline points="10 9 9 9 8 9"/>
              </svg>
            </div>
            <span class="rounded-full px-3 py-1 text-xs font-semibold" style="background: rgba(26,86,219,0.2); color: #5BB8D4;">IA generativa</span>
          </div>
          <h3 class="mb-3 text-2xl font-bold text-white" style="font-family: 'Plus Jakarta Sans Variable', sans-serif;">Contratos com IA</h3>
          <p class="text-base leading-relaxed" style="color: rgba(255,255,255,0.65);">
            Faça upload do PDF do contrato. A IA extrai automaticamente todas as cláusulas, tolerâncias e volumes — sem digitação manual.
          </p>
          <!-- Fake contract preview -->
          <div class="mt-6 rounded-xl p-4" style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1);">
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-medium text-white/50">Contrato extraído</span>
              <span class="rounded-full px-2 py-0.5 text-xs" style="background: rgba(91,184,212,0.2); color: #5BB8D4;">Ativo</span>
            </div>
            <div class="space-y-2">
              {["QDC: 85.000 m³/dia", "Tolerância: ±5%", "Vigência: 12 meses"].map(item => (
                <div class="flex items-center gap-2">
                  <span class="size-1.5 rounded-full flex-shrink-0" style="background: #5BB8D4;"></span>
                  <span class="text-xs text-white/60">{item}</span>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- Programação Diária & Mensal — light -->
        <div class="animate-on-scroll flex flex-col rounded-2xl p-8" style="background: #F4F7FA; border: 1px solid #E2E8F0;">
          <div class="mb-4 flex items-center gap-3">
            <div class="flex size-10 items-center justify-center rounded-xl" style="background: white;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1A56DB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                <line x1="16" y1="2" x2="16" y2="6"/>
                <line x1="8" y1="2" x2="8" y2="6"/>
                <line x1="3" y1="10" x2="21" y2="10"/>
              </svg>
            </div>
            <span class="rounded-full px-3 py-1 text-xs font-semibold" style="background: rgba(26,86,219,0.1); color: #1A56DB;">Automação</span>
          </div>
          <h3 class="mb-3 text-xl font-bold" style="color: #0D1B2A; font-family: 'Plus Jakarta Sans Variable', sans-serif;">Programação Diária & Mensal</h3>
          <p class="text-sm leading-relaxed" style="color: #4A5568;">
            Dashboard por unidade com controle granular do volume programado vs. contratado.
          </p>
        </div>
      </div>

      <!-- Row 2: 1fr / 1fr / 2fr -->
      <div class="grid gap-5 lg:grid-cols-[1fr_1fr_2fr]">
        <!-- Alertas de Desvio -->
        <div class="animate-on-scroll flex flex-col rounded-2xl p-8" style="background: #F4F7FA; border: 1px solid #E2E8F0;">
          <div class="mb-4 flex size-10 items-center justify-center rounded-xl" style="background: rgba(229,62,62,0.08);">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#E53E3E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
              <line x1="12" y1="9" x2="12" y2="13"/>
              <line x1="12" y1="17" x2="12.01" y2="17"/>
            </svg>
          </div>
          <h3 class="mb-2 text-xl font-bold" style="color: #0D1B2A; font-family: 'Plus Jakarta Sans Variable', sans-serif;">Alertas de Desvio</h3>
          <p class="text-sm leading-relaxed" style="color: #4A5568;">Notificações em tempo real quando uma unidade ultrapassa os limites de tolerância do contrato.</p>
        </div>

        <!-- Gestão de Multas -->
        <div class="animate-on-scroll flex flex-col rounded-2xl p-8" style="background: #F4F7FA; border: 1px solid #E2E8F0;">
          <div class="mb-4 flex size-10 items-center justify-center rounded-xl" style="background: rgba(26,86,219,0.08);">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1A56DB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <polyline points="12 6 12 12 16 14"/>
            </svg>
          </div>
          <h3 class="mb-2 text-xl font-bold" style="color: #0D1B2A; font-family: 'Plus Jakarta Sans Variable', sans-serif;">Gestão de Multas</h3>
          <p class="text-sm leading-relaxed" style="color: #4A5568;">Cálculo automático de PVEMA, PVEME e sobredemanda. Saiba exatamente quanto vai pagar antes da fatura chegar.</p>
        </div>

        <!-- Acurácia — blue accent -->
        <div class="animate-on-scroll flex flex-col rounded-2xl p-8" style="background: #1A56DB;">
          <div class="mb-4 flex size-10 items-center justify-center rounded-xl" style="background: rgba(255,255,255,0.15);">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
            </svg>
          </div>
          <span class="mb-4 self-start rounded-full px-3 py-1 text-xs font-semibold" style="background: rgba(255,255,255,0.15); color: white;">Machine Learning</span>
          <h3 class="mb-3 text-2xl font-bold text-white" style="font-family: 'Plus Jakarta Sans Variable', sans-serif;">Acurácia de Programação</h3>
          <p class="text-base leading-relaxed" style="color: rgba(255,255,255,0.8);">
            Analytics detalhados de acurácia por unidade e período, com análise de causas para cada desvio identificado.
          </p>
          <div class="mt-6 flex gap-8">
            <div>
              <p class="font-extrabold text-white" style="font-size: 28px; line-height: 1; font-family: 'Plus Jakarta Sans Variable', sans-serif;">97.3%</p>
              <p class="mt-1" style="font-size: 12px; color: rgba(255,255,255,0.7);">acurácia média</p>
            </div>
            <div>
              <p class="font-extrabold text-white" style="font-size: 28px; line-height: 1; font-family: 'Plus Jakarta Sans Variable', sans-serif;">↓82%</p>
              <p class="mt-1" style="font-size: 12px; color: rgba(255,255,255,0.7);">desvios no 1º mês</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Row 3: full-width Assistente IA -->
      <div class="animate-on-scroll rounded-2xl p-10" style="background: #0D1B2A;">
        <div class="grid gap-8 lg:grid-cols-[1fr_1fr]">
          <div>
            <div class="mb-4 flex items-center gap-3">
              <div class="flex size-10 items-center justify-center rounded-xl" style="background: rgba(26,86,219,0.25);">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#5BB8D4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                </svg>
              </div>
              <span class="rounded-full px-3 py-1 text-xs font-semibold" style="background: rgba(91,184,212,0.15); color: #5BB8D4;">Chat IA</span>
            </div>
            <h3 class="mb-4 text-2xl font-bold text-white" style="font-family: 'Plus Jakarta Sans Variable', sans-serif;">Assistente IA</h3>
            <p class="text-base leading-relaxed" style="color: rgba(255,255,255,0.65);">
              Pergunte sobre qualquer cláusula do contrato, consulte o histórico de consumo ou simule cenários de programação. O assistente conhece todos os seus dados.
            </p>
          </div>
          <!-- Chat preview -->
          <div class="space-y-3 rounded-xl p-5" style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.08);">
            <div class="flex gap-3">
              <div class="size-7 flex-shrink-0 rounded-full flex items-center justify-center text-xs font-bold" style="background: rgba(255,255,255,0.1); color: white;">U</div>
              <div class="rounded-xl rounded-tl-none px-4 py-2.5 text-sm" style="background: rgba(255,255,255,0.08); color: rgba(255,255,255,0.8);">
                Qual é a tolerância do contrato da Unidade B para este mês?
              </div>
            </div>
            <div class="flex gap-3">
              <div class="size-7 flex-shrink-0 rounded-full flex items-center justify-center text-xs font-bold" style="background: #1A56DB; color: white;">IA</div>
              <div class="rounded-xl rounded-tl-none px-4 py-2.5 text-sm" style="background: rgba(26,86,219,0.2); color: rgba(255,255,255,0.85);">
                A Unidade B tem tolerância de <strong class="text-white">±5%</strong> sobre QDC de <strong class="text-white">42.000 m³/dia</strong>. Consumo acumulado até hoje está dentro da faixa.
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
