---
import { pgTestimonials, pgStatsBanner } from "~/data/programa-gas";
---

<section id="depoimentos" class="py-24" style="background-color: #F4F7FA;">
  <div class="mx-auto max-w-7xl px-6">
    <div class="mb-16">
      <span class="mb-4 inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.1em]" style="color: #1A56DB;">
        <span style="color: rgba(26,86,219,0.4);">──</span>
        Depoimentos
      </span>
      <h2
        class="mt-3 text-3xl font-extrabold lg:text-4xl"
        style="color: #0D1B2A; font-family: 'Plus Jakarta Sans Variable', sans-serif;"
      >
        O que dizem quem já programa com precisão.
      </h2>
    </div>

    <!-- Testimonial cards -->
    <div class="grid gap-6 lg:grid-cols-3">
      {pgTestimonials.map((t) => (
        <div
          class="animate-on-scroll flex flex-col rounded-2xl p-8"
          style={t.dark
            ? "background: #0D1B2A; border: 1px solid rgba(255,255,255,0.08);"
            : "background: white; border: 1px solid #E2E8F0;"}
        >
          <!-- Dash lines decorative -->
          <div class="mb-4 flex gap-1">
            {Array.from({ length: 5 }).map(() => (
              <div class="h-0.5 w-5 rounded-full" style={`background: ${t.dark ? '#5BB8D4' : '#1A56DB'};`}></div>
            ))}
          </div>

          <blockquote class="flex-1 text-base leading-relaxed" style={t.dark ? "color: rgba(255,255,255,0.75);" : "color: #4A5568;"}>
            "{t.quote}"
          </blockquote>

          <div class="mt-6 flex items-center gap-3 border-t pt-6" style={`border-color: ${t.dark ? 'rgba(255,255,255,0.1)' : '#E2E8F0'};`}>
            <div
              class="flex size-10 flex-shrink-0 items-center justify-center rounded-full text-sm font-bold text-white"
              style="background: #1A56DB;"
            >
              {t.initials}
            </div>
            <div>
              <p class="text-sm font-semibold" style={t.dark ? "color: white;" : "color: #0D1B2A;"}>{t.name}</p>
              <p class="text-xs" style={t.dark ? "color: rgba(255,255,255,0.45);" : "color: #4A5568;"}>{t.role}</p>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Stats banner -->
    <div
      class="mt-12 grid gap-6 rounded-2xl px-10 py-10 lg:grid-cols-3"
      style="background: #1A56DB;"
    >
      {pgStatsBanner.map((stat) => (
        <div class="text-center">
          <p class="text-4xl font-extrabold text-white" style="font-family: 'Plus Jakarta Sans Variable', sans-serif;">
            {stat.value}
          </p>
          <p class="mt-1 text-sm" style="color: rgba(255,255,255,0.75);">{stat.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>
