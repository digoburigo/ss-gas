---
import PGLogo from "~/components/programa-gas/PGLogo.astro";
import { pgFooterLinks, pgContactInfo } from "~/data/programa-gas";
---

<footer style="background-color: #0A1525; border-top: 1px solid rgba(255,255,255,0.06);">
  <div class="mx-auto max-w-7xl px-6 py-16">
    <div class="grid gap-12 lg:grid-cols-[2fr_1fr_1fr_1fr_1fr]">
      <!-- Brand column -->
      <div>
        <PGLogo />
        <p class="mt-4 max-w-xs text-sm leading-relaxed" style="color: rgba(255,255,255,0.5);">
          Programação de gás com precisão e inteligência artificial. Para quem não pode errar.
        </p>
      </div>

      <!-- Link columns -->
      {pgFooterLinks.map((col) => (
        <div>
          <h4 class="mb-4 text-sm font-semibold uppercase tracking-wider text-white">{col.title}</h4>
          <ul class="space-y-3">
            {col.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm transition-colors hover:text-white"
                  style="color: rgba(255,255,255,0.5);"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}

      <!-- Fale conosco column -->
      <div>
        <h4 class="mb-4 text-sm font-semibold uppercase tracking-wider text-white">Fale conosco</h4>
        <div class="space-y-3">
          <a
            href={`mailto:${pgContactInfo.email}`}
            class="block text-sm transition-colors hover:text-white"
            style="color: rgba(255,255,255,0.5);"
          >
            {pgContactInfo.email}
          </a>
          <a
            href="#contato"
            class="mt-4 inline-block rounded-lg px-4 py-2 text-sm font-semibold text-white transition-all hover:opacity-90"
            style="background-color: #1A56DB;"
          >
            Agende uma Demo
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom bar -->
    <div
      class="mt-12 flex flex-col items-center justify-between gap-4 border-t pt-8 text-sm sm:flex-row"
      style="border-color: rgba(255,255,255,0.06); color: rgba(255,255,255,0.35);"
    >
      <p>© 2025 programagas.ai — Todos os direitos reservados</p>
      <div class="flex gap-6">
        <a href="#contato" class="transition-colors hover:text-white/60">Política de Privacidade</a>
        <a href="#contato" class="transition-colors hover:text-white/60">Termos de Uso</a>
      </div>
    </div>
  </div>
</footer>
