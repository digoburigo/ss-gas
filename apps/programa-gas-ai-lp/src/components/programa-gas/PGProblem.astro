---
import { pgProblems } from "~/data/programa-gas";

const dotColors: Record<string, string> = {
  red: "#f87171",
  teal: "#5BB8D4",
};
---

<section id="problema" class="py-24" style="background-color: #F4F7FA;">
  <div class="mx-auto max-w-7xl px-6">
    <!-- Section label -->
    <div class="mb-16">
      <span
        class="mb-4 inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.1em]"
        style="color: #1A56DB;"
      >
        <span style="color: rgba(26,86,219,0.4);">──</span>
        O PROBLEMA
      </span>
      <h2
        class="mt-3 text-3xl font-extrabold lg:text-4xl"
        style="color: #0D1B2A; font-family: 'Plus Jakarta Sans Variable', sans-serif;"
      >
        Programar gás ainda é manual, arriscado e caro.
      </h2>
      <p class="mt-4 max-w-2xl text-lg" style="color: #4A5568;">
        A maioria das empresas ainda depende de planilhas e intuição para programar o consumo diário e mensal. O resultado: desvios, multas e retrabalho todo mês.
      </p>
    </div>

    <!-- Cards -->
    <div class="grid gap-6 lg:grid-cols-3">
      {pgProblems.map((card) => (
        <div
          class="animate-on-scroll flex flex-col rounded-2xl p-8"
          style={card.dark
            ? "background-color: #0D1B2A;"
            : "background: white; border: 1px solid #E2E8F0;"}
        >
          <!-- Icon -->
          <div
            class="mb-6 flex size-12 items-center justify-center rounded-xl"
            style={card.dark
              ? "background: rgba(26, 86, 219, 0.2);"
              : "background: #F4F7FA;"}
          >
            {card.icon === "spreadsheet" && (
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke={card.dark ? "#5BB8D4" : "#1A56DB"} stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="18" height="18" rx="2"/>
                <line x1="3" y1="9" x2="21" y2="9"/>
                <line x1="3" y1="15" x2="21" y2="15"/>
                <line x1="9" y1="3" x2="9" y2="21"/>
                <line x1="15" y1="3" x2="15" y2="21"/>
              </svg>
            )}
            {card.icon === "alert" && (
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#5BB8D4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
                <line x1="12" y1="9" x2="12" y2="13"/>
                <line x1="12" y1="17" x2="12.01" y2="17"/>
              </svg>
            )}
            {card.icon === "trending" && (
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke={card.dark ? "#5BB8D4" : "#1A56DB"} stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/>
                <polyline points="16 7 22 7 22 13"/>
              </svg>
            )}
          </div>

          <h3
            class="mb-3 text-xl font-bold"
            style={card.dark ? "color: white;" : "color: #0D1B2A;"}
          >
            {card.title}
          </h3>
          <p
            class="flex-1 text-base leading-relaxed"
            style={card.dark ? "color: rgba(255,255,255,0.65);" : "color: #4A5568;"}
          >
            {card.description}
          </p>

          <div class="mt-6 flex items-center gap-2">
            <span
              class="size-2 rounded-full flex-shrink-0"
              style={`background: ${dotColors[card.tagDot]};`}
            ></span>
            <span
              class="text-sm font-medium"
              style={`color: ${dotColors[card.tagDot]};`}
            >
              {card.tag}
            </span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
