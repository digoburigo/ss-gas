---
import { CometCard } from "~/components/ui/comet-card";
import { altosAIPortfolio } from "~/data/altos-ai";

const featured = altosAIPortfolio.find((p) => p.featured);
const others = altosAIPortfolio.filter((p) => !p.featured);
---

<section id="portfolio" class="bg-[#FAFCFD] py-24 lg:py-32" aria-label="Portfólio">
  <div class="mx-auto max-w-7xl px-6 lg:px-20">
    <!-- Header -->
    <div class="mb-16 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between animate-on-scroll">
      <div>
        <div class="mb-4 flex items-center gap-3">
          <div class="h-px w-8 bg-altos-teal"></div>
          <span class="text-xs font-medium uppercase tracking-[0.12em] text-altos-teal">PORTFÓLIO</span>
        </div>
        <h2
          class="font-[var(--font-jakarta)] text-4xl font-extrabold tracking-tight text-altos-dark lg:text-5xl"
        >
          Trabalho que fala por si.
        </h2>
      </div>
      <a
        href="#contato"
        class="shrink-0 text-sm font-medium text-altos-teal transition-colors hover:text-altos-dark"
      >
        Ver todos →
      </a>
    </div>

    <!-- Featured project -->
    {featured && (
      <div class="mb-8 animate-on-scroll">
        <CometCard client:visible>
          <div class="overflow-hidden rounded-2xl bg-altos-dark">
            <div class="flex flex-col lg:flex-row">
              <!-- Browser mockup left -->
              <div class="overflow-hidden lg:flex-[1.3]">
                <!-- Browser chrome -->
                <div class="flex items-center gap-2 border-b border-white/10 bg-altos-secondary px-4 py-3">
                  <div class="flex gap-1.5">
                    <div class="size-2.5 rounded-full" style="background-color: #FF5F56;"></div>
                    <div class="size-2.5 rounded-full" style="background-color: #FFBD2E;"></div>
                    <div class="size-2.5 rounded-full" style="background-color: #27C93F;"></div>
                  </div>
                  {featured.link ? (
                    <div class="ml-3 flex-1 truncate rounded bg-white/10 px-2 py-0.5 text-xs text-white/50">
                      {featured.link.replace("https://", "")}
                    </div>
                  ) : (
                    <div class="ml-3 flex-1 rounded bg-white/10 px-2 py-0.5 text-xs text-white/50">
                      altosai.com.br
                    </div>
                  )}
                </div>
                <!-- Screenshot with hover zoom -->
                <div class="group relative aspect-[16/11] overflow-hidden">
                  <img
                    src={featured.image}
                    alt={`Screenshot do projeto ${featured.title}`}
                    class="h-full w-full object-cover object-left-top transition-transform duration-500 group-hover:scale-105"
                    width="580"
                    height="362"
                    loading="lazy"
                    decoding="async"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-altos-dark/30 to-transparent"></div>
                </div>
              </div>

              <!-- Project info right -->
              <div class="flex min-w-0 flex-col justify-center p-8 lg:flex-1 lg:p-10">
                <!-- Destaque badge + category -->
                <div class="mb-5 flex flex-wrap items-center gap-2">
                  <span class="inline-flex items-center gap-1.5 rounded-full bg-altos-teal/20 px-3 py-1 text-xs font-semibold text-altos-teal-light">
                    ✦ Destaque
                  </span>
                  <span class="rounded-full bg-white/10 px-3 py-1 text-xs font-medium text-white/70">
                    {featured.category}
                  </span>
                </div>

                <!-- Tech tags -->
                <div class="mb-4 flex flex-wrap gap-1.5">
                  {featured.techStack.map((tech) => (
                    <span class="rounded border border-white/10 bg-white/5 px-2 py-0.5 text-xs font-medium text-white/60">
                      {tech}
                    </span>
                  ))}
                </div>

                <!-- Title -->
                <h3
                  class="font-[var(--font-jakarta)] font-extrabold text-white"
                  style="font-size: clamp(1.25rem, 2vw, 1.625rem);"
                >
                  {featured.link ? (
                    <a href={featured.link} target="_blank" rel="noopener" class="transition-colors hover:text-altos-teal-light">
                      {featured.title}
                    </a>
                  ) : (
                    featured.title
                  )}
                </h3>

                <!-- Description -->
                <p class="mt-3 text-sm leading-relaxed text-white/60">
                  {featured.description}
                </p>

                <!-- Metrics -->
                {(featured.metric || featured.metricLabel) && (
                  <div class="mt-8 flex items-end gap-2">
                    <span
                      class="font-[var(--font-jakarta)] font-extrabold text-altos-teal-light"
                      style="font-size: 2.5rem; line-height: 1; letter-spacing: -0.04em;"
                    >
                      {featured.metric}
                    </span>
                    <span class="mb-1 text-sm text-white/50">{featured.metricLabel}</span>
                  </div>
                )}

                <!-- Result -->
                <div class="mt-4 flex items-center gap-2">
                  <svg class="size-4 shrink-0 text-green-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="10" />
                    <path d="m9 12 2 2 4-4" />
                  </svg>
                  <span class="text-xs font-semibold text-green-400">{featured.result}</span>
                </div>

                <!-- CTA -->
                {featured.link && (
                  <a
                    href={featured.link}
                    target="_blank"
                    rel="noopener"
                    class="mt-6 inline-flex h-10 w-fit items-center gap-2 rounded-md bg-altos-teal px-6 text-sm font-semibold text-white transition-all hover:bg-altos-teal-light hover:-translate-y-0.5"
                  >
                    Ver projeto
                    <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
                    </svg>
                  </a>
                )}
              </div>
            </div>
          </div>
        </CometCard>
      </div>
    )}

    <!-- Secondary cards -->
    <div class="grid gap-6 md:grid-cols-2">
      {others.map((project, i) => (
        <div
          class="animate-on-scroll"
          style={`animation-delay: ${i * 100}ms;`}
        >
          <CometCard client:visible>
            <div class="group overflow-hidden rounded-2xl bg-altos-dark transition-transform duration-300 hover:-translate-y-1">
              <!-- Browser chrome -->
              <div class="flex items-center gap-2 border-b border-white/10 bg-altos-secondary px-4 py-2.5">
                <div class="flex gap-1.5">
                  <div class="size-2 rounded-full" style="background-color: #FF5F56;"></div>
                  <div class="size-2 rounded-full" style="background-color: #FFBD2E;"></div>
                  <div class="size-2 rounded-full" style="background-color: #27C93F;"></div>
                </div>
                {project.link ? (
                  <div class="ml-3 flex-1 truncate rounded bg-white/10 px-2 py-0.5 text-xs text-white/40">
                    {project.link.replace("https://", "")}
                  </div>
                ) : (
                  <div class="ml-3 flex-1 rounded bg-white/10 px-2 py-0.5 text-xs text-white/40">
                    altosai.com.br
                  </div>
                )}
              </div>

              <!-- Screenshot -->
              <div class="relative aspect-[16/7] overflow-hidden">
                <img
                  src={project.image}
                  alt={`Screenshot do projeto ${project.title}`}
                  class="h-full w-full object-cover object-top transition-transform duration-500 group-hover:scale-105"
                  width="560"
                  height="245"
                  loading="lazy"
                  decoding="async"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-altos-dark/40 to-transparent"></div>
              </div>

              <!-- Content -->
              <div class="px-6 py-5">
                <!-- Category pill + tech tags -->
                <div class="mb-3 flex flex-wrap items-center gap-1.5">
                  <span class="rounded-full bg-altos-teal/20 px-2.5 py-0.5 text-xs font-medium text-altos-teal-light">
                    {project.category}
                  </span>
                  {project.techStack.map((tech) => (
                    <span class="rounded border border-white/10 bg-white/5 px-2 py-0.5 text-xs font-medium text-white/50">
                      {tech}
                    </span>
                  ))}
                </div>

                <!-- Title -->
                <h3 class="font-[var(--font-jakarta)] text-xl font-bold text-white">
                  {project.link ? (
                    <a href={project.link} target="_blank" rel="noopener" class="transition-colors hover:text-altos-teal-light">
                      {project.title}
                    </a>
                  ) : (
                    project.title
                  )}
                </h3>

                <p class="mt-2 text-sm leading-relaxed text-white/50">{project.description}</p>

                <!-- Result -->
                <div class="mt-4 flex items-center gap-2">
                  <svg class="size-4 shrink-0 text-green-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="10" />
                    <path d="m9 12 2 2 4-4" />
                  </svg>
                  <span class="text-xs font-semibold text-green-400">{project.result}</span>
                </div>

                <!-- Ghost CTA -->
                {project.link && (
                  <a
                    href={project.link}
                    target="_blank"
                    rel="noopener"
                    class="mt-4 inline-flex h-8 items-center gap-1.5 rounded border border-white/20 px-4 text-xs font-semibold text-white/70 transition-all hover:border-altos-teal hover:text-altos-teal-light"
                  >
                    Ver projeto
                    <svg class="size-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
                    </svg>
                  </a>
                )}
              </div>
            </div>
          </CometCard>
        </div>
      ))}
    </div>
  </div>
</section>
