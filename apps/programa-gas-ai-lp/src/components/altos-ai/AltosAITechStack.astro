---
import AwsIcon from "~/components/icons/aws.astro";
import BunIcon from "~/components/icons/bun.astro";
import ClaudeAiIcon from "~/components/icons/claude-ai.astro";
import DockerIcon from "~/components/icons/docker.astro";
import GitIcon from "~/components/icons/git.astro";
import GithubIcon from "~/components/icons/github.astro";
import JavaScriptIcon from "~/components/icons/javascript.astro";
import NodejsIcon from "~/components/icons/nodejs.astro";
import OpenAiIcon from "~/components/icons/openai.astro";
import PostgreSqlIcon from "~/components/icons/postgresql.astro";
import ReactIcon from "~/components/icons/react.astro";
import TailwindCssIcon from "~/components/icons/tailwindcss.astro";
import TypeScriptIcon from "~/components/icons/typescript.astro";
import { altosAITechStack } from "~/data/altos-ai";

const techIconMap = {
  aws: AwsIcon,
  bun: BunIcon,
  "claude-ai": ClaudeAiIcon,
  docker: DockerIcon,
  git: GitIcon,
  github: GithubIcon,
  javascript: JavaScriptIcon,
  nodejs: NodejsIcon,
  openai: OpenAiIcon,
  postgresql: PostgreSqlIcon,
  react: ReactIcon,
  tailwindcss: TailwindCssIcon,
  typescript: TypeScriptIcon,
} as const;

type TechIconKey = keyof typeof techIconMap;
---

<section id="sobre" class="bg-altos-surface py-24 lg:py-32" aria-label="Sobre e Tecnologias">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <!-- About section: 2-col -->
    <div class="mb-24 grid items-center gap-16 lg:grid-cols-2">
      <div class="animate-on-scroll">
        <div class="mb-6 flex items-center gap-3">
          <div class="h-px w-8 bg-altos-teal"></div>
          <span class="text-xs font-medium uppercase tracking-[0.12em] text-altos-teal">SOBRE A EMPRESA</span>
        </div>
        <h2 class="font-[var(--font-jakarta)] text-4xl font-extrabold tracking-tight text-altos-dark md:text-5xl">
          Sobre a
          <span style="background: linear-gradient(145deg, #0a1e3c 10%, #1e6fa0 65%, #0a2d50); background-clip: text; -webkit-background-clip: text; -webkit-text-fill-color: transparent;"> Altos AI</span>
        </h2>
        <p class="mt-6 text-lg leading-relaxed text-altos-body">
        Somos uma software house brasileira diferente e especializada em desenvolvimento de soluções digitais. Nossa missão: reduzir o custo e aumentar a eficiencia de criar software confiável e escalável, com base em qualidade técnica.

        </p>
        <p class="mt-4 text-lg leading-relaxed text-altos-body">
      Com +15 anos de mercado e uma equipe multidisciplinar, entregamos projetos que combinam velocidade de startup com a maturidade técnica de grandes empresas.

        </p>

        <div class="mt-8 flex flex-wrap gap-10">
          <div class="flex items-center gap-3">
            <div class="flex size-12 items-center justify-center rounded-xl bg-altos-teal/10">
              <svg class="size-6 text-altos-teal" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" />
              </svg>
            </div>
            <div>
              <div class="font-[var(--font-jakarta)] text-2xl font-extrabold text-altos-dark">50+</div>
              <div class="text-sm text-altos-body">Clientes atendidos</div>
            </div>
          </div>
          <div class="flex items-center gap-3">
            <div class="flex size-12 items-center justify-center rounded-xl bg-altos-teal/10">
              <svg class="size-6 text-altos-teal" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.59 14.37a6 6 0 01-5.84 7.38v-4.8m5.84-2.58a14.98 14.98 0 006.16-12.12A14.98 14.98 0 009.631 8.41m5.96 5.96a14.926 14.926 0 01-5.841 2.58m-.119-8.54a6 6 0 00-7.381 5.84h4.8m2.58-5.84a14.927 14.927 0 00-2.58 5.84m2.699 2.7c-.103.021-.207.041-.311.06a15.09 15.09 0 01-2.448-2.448 14.9 14.9 0 01.06-.312m-2.24 2.39a4.493 4.493 0 00-1.757 4.306 4.493 4.493 0 004.306-1.758M16.5 9a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0z" />
              </svg>
            </div>
            <div>
              <div class="font-[var(--font-jakarta)] text-2xl font-extrabold text-altos-dark">50+</div>
              <div class="text-sm text-altos-body">Projetos entregues</div>
            </div>
          </div>
          <div class="flex items-center gap-3">
            <div class="flex size-12 items-center justify-center rounded-xl bg-altos-teal/10">
              <svg class="size-6 text-altos-teal" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" />
              </svg>
            </div>
            <div>
              <div class="font-[var(--font-jakarta)] text-2xl font-extrabold text-altos-dark">98%</div>
              <div class="text-sm text-altos-body">Satisfação dos clientes</div>
            </div>
          </div>
        </div>
      </div>

      <div class="animate-on-scroll relative">
        <div class="absolute -inset-4 rounded-3xl bg-gradient-to-r from-altos-teal/20 to-altos-teal-light/20 blur-2xl" aria-hidden="true"></div>
        <img
          src="/altos-ai/team-photo.jpg"
          alt="Equipe da Altos AI — software house brasileira especializada em IA"
          class="relative w-full rounded-2xl shadow-2xl"
          width="600"
          height="400"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>

    <!-- Tech stack: marquee strip -->
    <div class="animate-on-scroll">
      <div class="mb-12 text-center">
        <h2 class="font-[var(--font-jakarta)] text-3xl font-extrabold tracking-tight text-altos-dark md:text-4xl">
          Tecnologias que
          <span style="background: linear-gradient(180deg, #14456a, #0a1e3c 50%, #1e6fa0); background-clip: text; -webkit-background-clip: text; -webkit-text-fill-color: transparent;"> dominamos</span>
        </h2>
        <p class="mt-4 text-lg text-altos-body">
          Stack moderna e confiável para soluções de alto desempenho
        </p>
      </div>

      <!-- Marquee container -->
      <div class="relative overflow-hidden">
        <!-- Fade masks -->
        <div class="pointer-events-none absolute left-0 top-0 z-10 h-full w-24 bg-gradient-to-r from-altos-surface to-transparent" aria-hidden="true"></div>
        <div class="pointer-events-none absolute right-0 top-0 z-10 h-full w-24 bg-gradient-to-l from-altos-surface to-transparent" aria-hidden="true"></div>

        <div class="flex w-max animate-marquee gap-8">
          {[...altosAITechStack, ...altosAITechStack].map((tech, idx) => {
            const iconKey = tech.icon as TechIconKey;
            const Icon = techIconMap[iconKey];

            return (
              <div
                class="flex flex-col items-center gap-2 opacity-70 transition-opacity hover:opacity-100"
                aria-hidden={idx >= altosAITechStack.length ? "true" : undefined}
              >
                <div class="flex size-14 items-center justify-center rounded-2xl bg-white shadow-sm">
                  <Icon class="size-7" />
                </div>
                <span class="whitespace-nowrap text-xs text-altos-body">{tech.name}</span>
              </div>
            );
          })}
        </div>
      </div>
    </div>
  </div>
</section>
